rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function member(weddingId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/weddings/$(weddingId)/members/$(request.auth.uid));
    }

    function admin(weddingId) {
      return member(weddingId) &&
        get(/databases/$(database)/documents/weddings/$(weddingId)/members/$(request.auth.uid)).data.isAdmin == true;
    }

    function validWedding(data, weddingId) {
      return data.id == weddingId &&
        data.brideName is string && data.brideName.size() > 0 && data.brideName.size() <= 100 &&
        data.groomName is string && data.groomName.size() > 0 && data.groomName.size() <= 100 &&
        data.weddingDate is string && data.location is string && data.location.size() <= 250;
    }

    match /weddings/{weddingId} {
      allow read: if member(weddingId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid &&
        validWedding(request.resource.data, weddingId);
      allow update: if admin(weddingId) && validWedding(request.resource.data, weddingId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.inviteCode == resource.data.inviteCode;

      match /members/{uid} {
        allow read: if signedIn() && (request.auth.uid == uid || member(weddingId));
        allow create: if signedIn() && uid == request.auth.uid &&
          request.resource.data.userId == uid &&
          request.resource.data.name is string && request.resource.data.email == request.auth.token.email &&
          request.resource.data.role is string && request.resource.data.role.size() <= 100 &&
          request.resource.data.side in ['ladkiwale', 'ladkewale', 'mutual'] &&
          (
            (getAfter(/databases/$(database)/documents/weddings/$(weddingId)).data.ownerId == uid &&
              request.resource.data.isAdmin == true)
            ||
            (request.resource.data.isAdmin == false &&
              request.resource.data.inviteCode == get(/databases/$(database)/documents/weddings/$(weddingId)).data.inviteCode)
          );
      }

      match /{kind}/{itemId} {
        function planningCollection() {
          return kind in ['budget', 'tasks', 'vendors', 'guests', 'moodboards', 'photos', 'shopping', 'checklists', 'team'];
        }
        function canWrite() {
          return signedIn() && existsAfter(/databases/$(database)/documents/weddings/$(weddingId)/members/$(request.auth.uid));
        }
        function validItem() {
          return request.resource.data.id == itemId &&
            (!('weddingId' in request.resource.data) || request.resource.data.weddingId == weddingId);
        }
        allow read: if planningCollection() && member(weddingId);
        allow create, update: if planningCollection() && canWrite() && validItem();
        allow delete: if planningCollection() && member(weddingId);
      }
    }

    match /users/{uid}/weddings/{weddingId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid &&
        request.resource.data.weddingId == weddingId &&
        request.resource.data.isAdmin == getAfter(/databases/$(database)/documents/weddings/$(weddingId)/members/$(uid)).data.isAdmin &&
        request.resource.data.userRole == getAfter(/databases/$(database)/documents/weddings/$(weddingId)/members/$(uid)).data.role &&
        request.resource.data.userSide == getAfter(/databases/$(database)/documents/weddings/$(weddingId)/members/$(uid)).data.side;
    }

    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.inviteCode == code &&
        getAfter(/databases/$(database)/documents/weddings/$(request.resource.data.id)).data.ownerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/weddings/$(request.resource.data.id)).data.inviteCode == code &&
        validWedding(request.resource.data, request.resource.data.id);
      allow update: if admin(resource.data.id) && request.resource.data.id == resource.data.id &&
        request.resource.data.inviteCode == code && validWedding(request.resource.data, resource.data.id);
    }
  }
}
